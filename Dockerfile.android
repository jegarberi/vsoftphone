# Builds an Android APK of the softphone.
#
#   docker build -f Dockerfile.android -t microsip-android .
#   docker run --rm -v "$PWD/build-android:/out" microsip-android
#
# The APK lands in build-android/. It targets Android 6.0 (API 23), the oldest
# version Qt 6.4 supports, and Qt 6.4 is the oldest Qt this app builds with.
# Pick the CPU with --build-arg ANDROID_ABI=armeabi-v7a (old 32-bit phones),
# arm64-v8a (the default), x86_64 or x86 (emulators).
#
# Building this accepts the Android SDK licence on your behalf (sdkmanager
# --licenses below); read it at https://developer.android.com/studio/terms.
FROM debian:bookworm

ARG ANDROID_ABI=arm64-v8a
ARG ANDROID_API=23
ARG QT_VERSION=6.4.3
# The NDK and SDK levels Qt 6.4 is built and tested with
ARG NDK_VERSION=23.1.7779620
ARG SDK_PLATFORM=33
ARG BUILD_TOOLS=33.0.2
ARG PJSIP_VERSION=2.17
ARG PJSIP_SHA256=065fe06c06788d97c35f563796d59f00ce52fe9558a52d7b490a042a966facce
ARG OPENSSL_VERSION=3.5.9
ARG OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
ARG OPUS_VERSION=1.5.2
ARG OPUS_SHA256=65c1d2f78b9f2fb20082c38cbe47c951ad5839345876e46941612ee87f9a7ce1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git pkg-config ca-certificates curl unzip \
    python3 python3-venv openjdk-17-jdk-headless autoconf automake libtool \
    && rm -rf /var/lib/apt/lists/*

ENV ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_NDK_ROOT=/opt/android-sdk/ndk/${NDK_VERSION} \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# --- Android SDK and NDK ----------------------------------------------------
RUN mkdir -p ${ANDROID_SDK_ROOT}/cmdline-tools \
    && curl -fsSL -o /tmp/tools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
    && unzip -q /tmp/tools.zip -d ${ANDROID_SDK_ROOT}/cmdline-tools \
    && mv ${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools ${ANDROID_SDK_ROOT}/cmdline-tools/latest \
    && rm /tmp/tools.zip \
    && yes | ${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager --licenses > /dev/null \
    && ${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager \
       "platform-tools" "platforms;android-${SDK_PLATFORM}" \
       "build-tools;${BUILD_TOOLS}" "ndk;${NDK_VERSION}" > /dev/null

# --- Qt: the Android kit, and the desktop kit for moc and the QML tools ------
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install -q aqtinstall==3.3.0 \
    && case "${ANDROID_ABI}" in \
         arm64-v8a) QT_ARCH=android_arm64_v8a ;; \
         armeabi-v7a) QT_ARCH=android_armv7 ;; \
         x86_64) QT_ARCH=android_x86_64 ;; \
         x86) QT_ARCH=android_x86 ;; \
         *) echo "unknown ANDROID_ABI ${ANDROID_ABI}"; exit 1 ;; \
       esac \
    && /opt/venv/bin/aqt install-qt linux desktop ${QT_VERSION} gcc_64 -O /opt/qt > /dev/null \
    && /opt/venv/bin/aqt install-qt linux android ${QT_VERSION} ${QT_ARCH} -O /opt/qt > /dev/null \
    && ln -s /opt/qt/${QT_VERSION}/${QT_ARCH} /opt/qt/android

# --- What the NDK calls this CPU ---------------------------------------------
# cc.env holds the compiler settings the three library builds share
RUN case "${ANDROID_ABI}" in \
      arm64-v8a) TRIPLE=aarch64-linux-android; OPENSSL_TARGET=android-arm64 ;; \
      armeabi-v7a) TRIPLE=armv7a-linux-androideabi; OPENSSL_TARGET=android-arm ;; \
      x86_64) TRIPLE=x86_64-linux-android; OPENSSL_TARGET=android-x86_64 ;; \
      x86) TRIPLE=i686-linux-android; OPENSSL_TARGET=android-x86 ;; \
    esac \
    && TOOLCHAIN=${ANDROID_NDK_ROOT}/toolchains/llvm/prebuilt/linux-x86_64 \
    && printf 'export TOOLCHAIN=%s\nexport TRIPLE=%s\nexport OPENSSL_TARGET=%s\nexport PATH=%s/bin:$PATH\nexport CC=%s/bin/%s%s-clang\nexport CXX=%s/bin/%s%s-clang++\nexport AR=%s/bin/llvm-ar\nexport RANLIB=%s/bin/llvm-ranlib\n' \
       "$TOOLCHAIN" "$TRIPLE" "$OPENSSL_TARGET" "$TOOLCHAIN" \
       "$TOOLCHAIN" "$TRIPLE" "${ANDROID_API}" "$TOOLCHAIN" "$TRIPLE" "${ANDROID_API}" \
       "$TOOLCHAIN" "$TOOLCHAIN" > /opt/cc.env

WORKDIR /src-deps

# --- OpenSSL (TLS and SRTP for PJSIP), static --------------------------------
RUN curl -fsSL -o openssl.tar.gz https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz \
    && echo "${OPENSSL_SHA256}  openssl.tar.gz" | sha256sum -c - \
    && tar -xzf openssl.tar.gz && cd openssl-${OPENSSL_VERSION} \
    && . /opt/cc.env && unset CC CXX AR RANLIB \
    && ./Configure ${OPENSSL_TARGET} -D__ANDROID_API__=${ANDROID_API} \
       no-shared no-tests no-engine no-dso --prefix=/opt/deps --libdir=lib > /dev/null \
    && make -j"$(nproc)" build_libs > /dev/null && make install_dev > /dev/null \
    && cd .. && rm -rf openssl-${OPENSSL_VERSION} openssl.tar.gz

# --- Opus, static -------------------------------------------------------------
RUN curl -fsSL -o opus.tar.gz https://downloads.xiph.org/releases/opus/opus-${OPUS_VERSION}.tar.gz \
    && echo "${OPUS_SHA256}  opus.tar.gz" | sha256sum -c - \
    && tar -xzf opus.tar.gz && cd opus-${OPUS_VERSION} \
    && . /opt/cc.env \
    && ./configure --host=${TRIPLE} --prefix=/opt/deps --disable-shared \
       --disable-doc --disable-extra-programs > /dev/null \
    && make -j"$(nproc)" install > /dev/null \
    && cd .. && rm -rf opus-${OPUS_VERSION} opus.tar.gz

# --- PJSIP, static, audio through OpenSL ES ----------------------------------
RUN curl -fsSL -o pjsip.tar.gz https://github.com/pjsip/pjproject/archive/refs/tags/${PJSIP_VERSION}.tar.gz \
    && echo "${PJSIP_SHA256}  pjsip.tar.gz" | sha256sum -c - \
    && tar -xzf pjsip.tar.gz && cd pjproject-${PJSIP_VERSION} \
    && printf '#define PJ_CONFIG_ANDROID 1\n#include <pj/config_site_sample.h>\n#undef PJ_HAS_IPV6\n#define PJ_HAS_IPV6 1\n#undef PJMEDIA_HAS_VIDEO\n#define PJMEDIA_HAS_VIDEO 0\n' \
       > pjlib/include/pj/config_site.h \
    && TARGET_ABI=${ANDROID_ABI} APP_PLATFORM=android-${ANDROID_API} \
       ./configure-android --use-ndk-cflags --prefix=/opt/pjsip \
       --with-ssl=/opt/deps --with-opus=/opt/deps \
       --disable-video --disable-libwebrtc --disable-libyuv \
       --disable-opencore-amr --disable-bcg729 --disable-silk > /tmp/pjsip-configure.log 2>&1 \
       || { tail -40 /tmp/pjsip-configure.log; exit 1; } \
    && grep -E "SSL support|opus_repacketizer|sound device backend" /tmp/pjsip-configure.log \
    && make dep > /dev/null 2>&1 \
    && (make -j"$(nproc)" lib > /tmp/pjsip-build.log 2>&1 || { grep -E "error|Error" /tmp/pjsip-build.log | head -30; exit 1; }) \
    && make install > /dev/null \
    && cd .. && rm -rf pjproject-${PJSIP_VERSION} pjsip.tar.gz

# --- The app ------------------------------------------------------------------
WORKDIR /app
COPY . .
# Some of Qt's Android kits arrive with their scripts not executable
# and `make android` passes in the signing key of the first build, so that later
# builds install over it
RUN --mount=type=secret,id=debugkey,target=/root/.android/debug.keystore \
    chmod +x /opt/qt/android/bin/* \
    && PKG_CONFIG_LIBDIR=/opt/pjsip/lib/pkgconfig /opt/qt/android/bin/qt-cmake -S . -B /build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DQT_HOST_PATH=/opt/qt/${QT_VERSION}/gcc_64 \
      -DANDROID_SDK_ROOT=${ANDROID_SDK_ROOT} -DANDROID_NDK_ROOT=${ANDROID_NDK_ROOT} \
      -DANDROID_PLATFORM=android-${ANDROID_API} \
      -DMICROSIP_PJSIP_PKGCONFIG=ON \
      -DMICROSIP_EXTRA_LIBRARY_DIRS=/opt/deps/lib \
    && cmake --build /build --target apk

# Gradle signs it with Android's debug key, so it installs for testing. Sign a
# real release with your own key.
RUN cp /build/android-build/build/outputs/apk/debug/android-build-debug.apk /microsip-clone-${ANDROID_ABI}.apk \
    && ${ANDROID_SDK_ROOT}/build-tools/${BUILD_TOOLS}/aapt dump badging /microsip-clone-${ANDROID_ABI}.apk \
       | grep -E "^package|sdkVersion|native-code|uses-permission"

CMD ["sh", "-c", "cp /microsip-clone-*.apk /out/ && (cp -n /root/.android/debug.keystore /out/ 2>/dev/null; ls -la /out)"]

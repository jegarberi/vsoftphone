# Builds an Android APK of the softphone.
#
#   docker build -f Dockerfile.android -t vsoftphone-android .
#   docker run --rm -v "$PWD/build-android:/out" vsoftphone-android
#
# The APK lands in build-android/. It targets Android 6.0 (API 23), the oldest
# version Qt 6.4 supports, and Qt 6.4 is the oldest Qt this app builds with.
# Pick the CPU with --build-arg ANDROID_ABI=armeabi-v7a (old 32-bit phones),
# arm64-v8a (the default), x86_64 or x86 (emulators).
#
# Building this accepts the Android SDK licence on your behalf (sdkmanager
# --licenses below); read it at https://developer.android.com/studio/terms.
FROM debian:bookworm

ARG ANDROID_ABI=arm64-v8a
ARG ANDROID_API=23
ARG QT_VERSION=6.4.3
# The NDK and SDK levels Qt 6.4 is built and tested with
ARG NDK_VERSION=23.1.7779620
ARG SDK_PLATFORM=33
ARG BUILD_TOOLS=33.0.2

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git pkg-config ca-certificates curl unzip \
    python3 python3-venv openjdk-17-jdk-headless autoconf automake libtool \
    && rm -rf /var/lib/apt/lists/*

ENV ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_NDK_ROOT=/opt/android-sdk/ndk/${NDK_VERSION} \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# --- Android SDK and NDK ----------------------------------------------------
RUN mkdir -p ${ANDROID_SDK_ROOT}/cmdline-tools \
    && curl -fsSL -o /tmp/tools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
    && unzip -q /tmp/tools.zip -d ${ANDROID_SDK_ROOT}/cmdline-tools \
    && mv ${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools ${ANDROID_SDK_ROOT}/cmdline-tools/latest \
    && rm /tmp/tools.zip \
    && yes | ${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager --licenses > /dev/null \
    && ${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager \
       "platform-tools" "platforms;android-${SDK_PLATFORM}" \
       "build-tools;${BUILD_TOOLS}" "ndk;${NDK_VERSION}" > /dev/null

# --- Qt: the Android kit, and the desktop kit for moc and the QML tools ------
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install -q aqtinstall==3.3.0 \
    && case "${ANDROID_ABI}" in \
         arm64-v8a) QT_ARCH=android_arm64_v8a ;; \
         armeabi-v7a) QT_ARCH=android_armv7 ;; \
         x86_64) QT_ARCH=android_x86_64 ;; \
         x86) QT_ARCH=android_x86 ;; \
         *) echo "unknown ANDROID_ABI ${ANDROID_ABI}"; exit 1 ;; \
       esac \
    && /opt/venv/bin/aqt install-qt linux desktop ${QT_VERSION} gcc_64 -O /opt/qt > /dev/null \
    && /opt/venv/bin/aqt install-qt linux android ${QT_VERSION} ${QT_ARCH} -O /opt/qt > /dev/null \
    && ln -s /opt/qt/${QT_VERSION}/${QT_ARCH} /opt/qt/android

# --- OpenSSL, Opus and PJSIP, static (versions and checksums in the script) --
COPY android/build-deps.sh /tmp/build-deps.sh
RUN ANDROID_ABI=${ANDROID_ABI} ANDROID_API=${ANDROID_API} /tmp/build-deps.sh /opt \
    && rm -rf /opt/src

# --- The app ------------------------------------------------------------------
WORKDIR /app
COPY . .
# Some of Qt's Android kits arrive with their scripts not executable
# and `make android` passes in the signing key of the first build, so that later
# builds install over it
RUN --mount=type=secret,id=debugkey,target=/root/.android/debug.keystore \
    chmod +x /opt/qt/android/bin/* \
    && PKG_CONFIG_LIBDIR=/opt/pjsip/lib/pkgconfig /opt/qt/android/bin/qt-cmake -S . -B /build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DQT_HOST_PATH=/opt/qt/${QT_VERSION}/gcc_64 \
      -DANDROID_SDK_ROOT=${ANDROID_SDK_ROOT} -DANDROID_NDK_ROOT=${ANDROID_NDK_ROOT} \
      -DANDROID_PLATFORM=android-${ANDROID_API} \
      -DVSOFTPHONE_PJSIP_PKGCONFIG=ON \
      -DVSOFTPHONE_EXTRA_LIBRARY_DIRS=/opt/deps/lib \
    && cmake --build /build --target apk

# Gradle signs it with Android's debug key, so it installs for testing. Sign a
# real release with your own key.
RUN cp /build/android-build/build/outputs/apk/debug/android-build-debug.apk /vsoftphone-${ANDROID_ABI}.apk \
    && ${ANDROID_SDK_ROOT}/build-tools/${BUILD_TOOLS}/aapt dump badging /vsoftphone-${ANDROID_ABI}.apk \
       | grep -E "^package|sdkVersion|native-code|uses-permission"

CMD ["sh", "-c", "cp /vsoftphone-*.apk /out/ && (cp -n /root/.android/debug.keystore /out/ 2>/dev/null; ls -la /out)"]
